@using core.Models
@inject HttpClient http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="ComponentForm" Data="form" Submit="@Save">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenLabel Text="Name" Style="width:7rem" />
            <RadzenTextBox @bind-Value="form.Name" Name="ComponentName" Placeholder="Component name" Style="flex:1" />
        </RadzenStack>
        <RadzenRequiredValidator Component="ComponentName" Text="Name is required" Popup="true" />

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem">
            <RadzenLabel Text="Description" Style="width:7rem" />
            <RadzenTextArea @bind-Value="form.Description" Name="ComponentDescription" Placeholder="Description" Style="flex:1" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenLabel Text="Quantity" Style="width:7rem" />
            <RadzenNumeric TValue="int" @bind-Value="form.Quantity" Name="Quantity"
                       Disabled="@(!CanEditQuantity)" Min="1" Placeholder="Quantity" Style="width:100%" />
            <RadzenNumericRangeValidator Component="Quantity" Min="1" Text="Quantity must be greater than zero" Popup="true" />
        </RadzenStack>

        

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Component Component { get; set; } = null!;
    [Parameter] public bool CanEditQuantity { get; set; } = true;

    private ComponentForm form = new();
    protected override async Task OnInitializedAsync()
    {
        if (Component is not null)
        {
            form = new ComponentForm
            {
                Name = Component.ComponentType.Name,
                Description = Component.ComponentType.Description,
                Quantity = Component.Quantity
            };
        }
    }

    private async Task Save(ComponentForm value)
    {
        try
        {
            var quantity = CanEditQuantity ? form.Quantity : Component?.Quantity ?? form.Quantity;
            var payload = new { form.Name, form.Description, Quantity = quantity };
            HttpResponseMessage response;

            if (Component is null)
            {
                response = await http.PostAsJsonAsync("components", payload);
            }
            else
            {
                response = await http.PutAsJsonAsync($"components/{Component.Id}", payload);
            }

            response.EnsureSuccessStatusCode();
            var savedComponent = await response.Content.ReadFromJsonAsync<Component>();
            DialogService.Close(savedComponent);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Components", $"Could not save component: {exception.Message}");
        }
    }

    private void Cancel()
    {
        DialogService.Close();
    }

    private sealed class ComponentForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int Quantity { get; set; }
    }
}