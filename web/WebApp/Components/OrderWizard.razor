@using core.Models
@using Radzen.Blazor
@inject HttpClient http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenSteps ShowStepsButtons="false" @bind-SelectedIndex="wizardStep">
    <Steps>
        <RadzenStepsItem Text="Order details">
            <RadzenTemplateForm TItem="Order" Data="newOrder">
                <RadzenStack Gap="1rem">
                    <RadzenTextBox @bind-Value="newOrder.Name" Name="OrderName" Placeholder="Order name" Style="width:100%" />
                    <RadzenTextArea @bind-Value="newOrder.Description" Name="OrderDescription" Placeholder="Description" Style="width:100%" />
                    <RadzenDatePicker @bind-Value="newOrder.OrderDate" Name="OrderDate" ReadOnly="true" Style="width:100%" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenStepsItem>
        <RadzenStepsItem Text="Boards">
            <RadzenStack Gap="0.5rem">
                <ItemSelector TItem="Board" TKey="int"
                              Items="boards"
                              @bind-SelectedItems="selectedBoards"
                              ItemKeySelector="board => board.Id"
                              ItemText="board => board.Name"
                              TextProperty="Name"
                              ValueProperty="Id"
                              KeepSelectedItemsInDropdown="true"
                              Placeholder="Select a board" />
            </RadzenStack>
        </RadzenStepsItem>
        <RadzenStepsItem Text="Components">
                        <RadzenDropDown TValue="int" @bind-Value="selectedBoardId" Data="DistinctSelectedBoards" TextProperty="Name" ValueProperty="Id"
                                                        Placeholder="Select a board" Style="width:100%; margin-bottom:1rem" />
            <ItemSelector TItem="OrderComponentOption" TKey="int"
                          Items="componentOptions"
                                                    @bind-SelectedItems="SelectedComponentsForBoard"
                          ItemKeySelector="component => component.Id"
                          ItemText="component => component.ComponentTypeName"
                          TextProperty="ComponentTypeName"
                          ValueProperty="Id"
                          StockSelector="component => AvailableQuantity(component.Id)"
                          CreateSelectedItem="(component, quantity) => component with { Quantity = quantity }"
                          ShowQuantity="true"
                          Placeholder="Select a component" />
        </RadzenStepsItem>
    </Steps>
</RadzenSteps>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-4">
    <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        @if (wizardStep > 0)
        {
            <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@Back" />
        }
        @if (wizardStep < 2)
        {
            <RadzenButton Text="Next" Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" Click="@Next" />
        }
        else
        {
            <RadzenButton Text="Save draft" Icon="save" ButtonStyle="ButtonStyle.Secondary" Click="@SaveDraft" Disabled="@HasComponents" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" Disabled="@(!CanSave)" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" Disabled="@(!CanSave)" />
        }
    </RadzenStack>
</RadzenStack>

@code {
    private int wizardStep;
    private Order newOrder = new() { OrderDate = DateTime.Now, Status = OrderStatus.Pending };
    private IList<Board> boards = new List<Board>
    {
        new Board { Id = 1, Name = "Demo board A" },
        new Board { Id = 2, Name = "Demo board B" }
    };
    private IList<OrderComponentOption> componentOptions = new List<OrderComponentOption>
    {
        new OrderComponentOption(1, "Type A", 5, ComponentStatus.Available),
        new OrderComponentOption(2, "Type B", 10, ComponentStatus.Available),
        new OrderComponentOption(3, "Type C", 0, ComponentStatus.OutOfStock)
    };

    private IList<Board> selectedBoards = new List<Board>();
    private readonly Dictionary<int, IList<OrderComponentOption>> componentsByBoard = new();
    private int selectedBoardId;

    private IEnumerable<Board> DistinctSelectedBoards => selectedBoards.GroupBy(board => board.Id).Select(group => group.First());
    private IList<OrderComponentOption> SelectedComponentsForBoard
    {
        get => selectedBoardId > 0 && componentsByBoard.TryGetValue(selectedBoardId, out var components) ? components : [];
        set
        {
            if (selectedBoardId > 0)
            {
                componentsByBoard[selectedBoardId] = value;
            }
        }
    }

    private bool HasComponents => componentsByBoard.Values.Any(components => components.Count > 0);
    private bool CanSave => DistinctSelectedBoards.Any() && DistinctSelectedBoards.All(board =>
        componentsByBoard.TryGetValue(board.Id, out var components) && components.Count > 0);

    private record OrderComponentOption(int Id, string ComponentTypeName, int Quantity, ComponentStatus Status);

    private int AvailableQuantity(int componentId)
    {
        var stock = componentOptions.First(component => component.Id == componentId).Quantity;
        var assigned = componentsByBoard.Values.SelectMany(components => components)
            .Where(component => component.Id == componentId)
            .Sum(component => component.Quantity);
        return Math.Max(0, stock - assigned);
    }

    private void Next()
    {
        if (wizardStep < 2)
        {
            if (wizardStep == 1 && selectedBoardId == 0)
            {
                selectedBoardId = DistinctSelectedBoards.FirstOrDefault()?.Id ?? 0;
            }
            wizardStep++;
        }
    }

    private void Back()
    {
        if (wizardStep > 0)
        {
            wizardStep--;
        }
    }

    private void Cancel()
    {
        DialogService.Close();
    }

    private void OnBoardChanged(object value)
    {
        selectedBoardId = Convert.ToInt32(value);
    }

    private async Task SaveDraft() => await PersistOrder(false);

    private async Task Save() => await PersistOrder(true);

    private async Task PersistOrder(bool finalize)
    {
        try
        {
            var orderResponse = await http.PostAsJsonAsync("orders", new
            {
                newOrder.Name,
                newOrder.Description,
                newOrder.OrderDate
            });
            orderResponse.EnsureSuccessStatusCode();
            var savedOrder = await orderResponse.Content.ReadFromJsonAsync<Order>() ?? newOrder;

            var boardResponse = await http.PutAsJsonAsync($"orders/{savedOrder.Id}/boards", new
            {
                BoardIds = DistinctSelectedBoards.Select(board => board.Id).ToList()
            });
            boardResponse.EnsureSuccessStatusCode();

            if (finalize)
            {
                var componentResponse = await http.PutAsJsonAsync($"orders/{savedOrder.Id}/components", new
                {
                    Components = componentsByBoard.Values
                        .SelectMany(components => components)
                        .GroupBy(component => component.Id)
                        .Select(group => new OrderComponentAssignment(group.Key, group.Sum(component => component.Quantity)))
                        .ToList()
                });
                componentResponse.EnsureSuccessStatusCode();

                var saveResponse = await http.PostAsync($"orders/{savedOrder.Id}/save", null);
                saveResponse.EnsureSuccessStatusCode();
                savedOrder = await saveResponse.Content.ReadFromJsonAsync<Order>() ?? savedOrder;
            }

            DialogService.Close(savedOrder);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Orders", $"Could not save order: {exception.Message}");
        }
    }
}