@using core.Models
@using Radzen.Blazor
@inject HttpClient http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="Board" Data="board" Submit="@Save">
    <RadzenStack Gap="1rem">
        <RadzenTextBox @bind-Value="board.Name" Name="BoardName" Placeholder="Board name" Style="width:100%" />
        <RadzenRequiredValidator Component="BoardName" Text="Name is required" Popup="true" />

        <RadzenTextArea @bind-Value="board.Description" Name="BoardDescription" Placeholder="Description" Style="width:100%" />

        <RadzenNumeric TValue="decimal" @bind-Value="length" Name="BoardLength" Placeholder="Length" Min="0.01m" Style="width:100%" />
        <RadzenNumericRangeValidator Component="BoardLength" Min="0.01" Text="Length must be greater than zero" Popup="true" />

        <RadzenNumeric TValue="decimal" @bind-Value="width" Name="BoardWidth" Placeholder="Width" Min="0.01m" Style="width:100%" />
        <RadzenNumericRangeValidator Component="BoardWidth" Min="0.01" Text="Width must be greater than zero" Popup="true" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private Board board = new();
    private decimal length;
    private decimal width;

    private async Task Save(Board value)
    {
        board.Length = (double)length;
        board.Width = (double)width;

        try
        {
            var response = await http.PostAsJsonAsync("boards", new
            {
                board.Name,
                board.Description,
                board.Length,
                board.Width
            });
            response.EnsureSuccessStatusCode();

            var createdBoard = await response.Content.ReadFromJsonAsync<Board>();
            DialogService.Close(createdBoard ?? board);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Boards", $"Could not create board: {exception.Message}");
        }
    }

    private void Cancel()
    {
        DialogService.Close();
    }
}
