@using core.Models
@using Radzen.Blazor
@inject HttpClient http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="Board" Data="board" Submit="@Save">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenLabel Text="Name" Style="width:7rem" />
            <RadzenTextBox @bind-Value="board.Name" Name="BoardName" Placeholder="Board name" Style="flex:1" />
        </RadzenStack>
        <RadzenRequiredValidator Component="BoardName" Text="Name is required" Popup="true" />

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem">
            <RadzenLabel Text="Description" Style="width:7rem" />
            <RadzenTextArea @bind-Value="board.Description" Name="BoardDescription" Placeholder="Description" Style="flex:1" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenLabel Text="Length" Style="width:7rem" />
            <RadzenNumeric TValue="decimal" @bind-Value="length" Name="BoardLength" Placeholder="Length" Min="0.01m" Style="flex:1" />
            <RadzenText Text="mm" />
        </RadzenStack>
        <RadzenNumericRangeValidator Component="BoardLength" Min="0.01" Text="Length must be greater than zero" Popup="true" />

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenLabel Text="Width" Style="width:7rem" />
            <RadzenNumeric TValue="decimal" @bind-Value="width" Name="BoardWidth" Placeholder="Width" Min="0.01m" Style="flex:1" />
            <RadzenText Text="mm" />
        </RadzenStack>
        <RadzenNumericRangeValidator Component="BoardWidth" Min="0.01" Text="Width must be greater than zero" Popup="true" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter]
    public Board InitialBoard { get; set; }

    private Board board = new();
    private decimal length;
    private decimal width;

    protected override void OnInitialized()
    {
        board = InitialBoard is null
            ? new Board()
            : new Board
            {
                Id = InitialBoard.Id,
                Name = InitialBoard.Name,
                Description = InitialBoard.Description,
                Length = InitialBoard.Length,
                Width = InitialBoard.Width
            };
        length = (decimal)board.Length;
        width = (decimal)board.Width;
    }

    private async Task Save(Board value)
    {
        board.Length = (double)length;
        board.Width = (double)width;

        try
        {
            var payload = new
            {
                board.Name,
                board.Description,
                board.Length,
                board.Width
            };
            var response = board.Id == 0
                ? await http.PostAsJsonAsync("boards", payload)
                : await http.PutAsJsonAsync($"boards/{board.Id}", payload);
            response.EnsureSuccessStatusCode();

            var savedBoard = await response.Content.ReadFromJsonAsync<Board>();
            DialogService.Close(savedBoard ?? board);
        }
        catch (Exception exception)
        {
            var operation = board.Id == 0 ? "create" : "update";
            NotificationService.Notify(NotificationSeverity.Error, "Boards", $"Could not {operation} board: {exception.Message}");
        }
    }

    private void Cancel()
    {
        DialogService.Close();
    }
}
